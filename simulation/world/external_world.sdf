<?xml version="1.0" ?>
<!--
  ============================================================
  external_world.sdf — Session 04
  ============================================================
  A PX4-compatible world for testing imported external mesh models.

  IMPORTANT: Like all PX4 worlds, this file has NO explicit
  <plugin> tags. Plugins are loaded from server.config via
  GZ_SIM_SERVER_CONFIG_PATH.

  One-time setup — copy to PX4 worlds directory:
    cp ~/Videos/Session_4/worlds/external_world.sdf \
       ~/PX4-Autopilot/Tools/simulation/gz/worlds/external_world.sdf

  Run with:
    Terminal 1:
      export GZ_SIM_RESOURCE_PATH=~/PX4-Autopilot/Tools/simulation/gz/models
      export GZ_SIM_SERVER_CONFIG_PATH=~/.simulation-gazebo/server.config
      export GZ_SIM_SYSTEM_PLUGIN_PATH=~/PX4-Autopilot/build/px4_sitl_default/src/modules/simulation/gz_plugins
      export GZ_MESH_FORCE_ASSIMP=1
      gz sim -r ~/PX4-Autopilot/Tools/simulation/gz/worlds/external_world.sdf

    Terminal 2 (after Gazebo is running):
      cd ~/PX4-Autopilot
      PX4_GZ_STANDALONE=1 PX4_GZ_WORLD=external_world make px4_sitl gz_x500
  ============================================================
-->
<sdf version="1.9">
  <world name="external_world">

    <!-- Physics — required rate for PX4 sensor integration -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Required by PX4 sensor plugins via server.config -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- GPS home position — required for NavSat/GPS sensor -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    
    
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.52 0.78 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun -->
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  <include>
      <uri>model://rugged-_mountain</uri>
      <name>rugged-_mountain</name>
       <static>true</static>
     <pose>0 17 -6.50 1.5708 0 0</pose>
  </include>
  
   <include>
      <uri>model://mountain</uri>
      <name>mountain</name>
       <static>true</static>
     <pose>-178.36 -49.72 -1.83 1.61 -0.10 -3.06</pose>
  </include>
  
  
 <include>
      <uri>model://oil-pipeline</uri>
      <name>oil-pipeline</name>
     <pose>-268.09 178.44 28 1.56 0.08 0.39</pose>
  </include>
  
  
  
   <include>
      <uri>model://radio_communications_tower</uri>
      <name>radio_communications_tower</name>
     <pose>-13.68 -199.99 27.36 1.5708 0 0</pose>
  </include>
  
  
  
  
  
  <include>
      <uri>model://radio_communications_tower</uri>
      <name>radio_communications_tower2</name>
     <pose>100 150 18 1.5708 0 0</pose>
  </include>
 
 
<include>
      <uri>model://radio_communications_tower</uri>
      <name>radio_communications_tower3</name>
     <pose>-216.53 167 30.11 1.5708 0 0</pose>
  </include>
  
  
  <include>
      <uri>model://helipad1</uri>
      <name>helipad1</name>
     <pose>22.75 -138.78 28.09 1.5708 0 0</pose>
  </include>
 
  <include>
      <uri>model://building_of_control</uri>
      <name>building_of_control</name>
     <pose>-161.31 -247.49 36.08 1.5708 0 0</pose>
  </include>


  <include>
      <uri>model://rusted_tank</uri>
      <name>rusted_tank</name>
     <pose>-149.63 -221.76 28.87 1.5708 0 0</pose>
  </include>
  
  
  <include>
      <uri>model://rusted_tank</uri>
      <name>rusted_tank2</name>
     <pose>-256.79 40.44 29 1.5708 0 0</pose>
  </include>
   
   <include>
      <uri>model://fuel_tank</uri>
      <name>fuel_tank</name>
     <pose>-51.45 198.47 24 1.50 -0.08 -1.53</pose>
  </include>
  
  

    <!-- ======================================================
         YOUR IMPORTED MODEL GOES HERE
         ======================================================
         Replace 'YourModelName' with the folder name you created
         in the walkthrough. The folder must be in GZ_SIM_RESOURCE_PATH.

         <include>
           <uri>model://YourModelName</uri>
           <name>imported_model_1</name>
           <pose>15 0 0 0 0 0</pose>
         </include>

         TIP: Place models at X=10 to X=30 so the drone (spawns at 0,0)
         can see them immediately. Keep Z=0 — the model.sdf handles
         vertical positioning via its own geometry and scale.
    ====================================================== -->
<!-- Clouds - light visual only -->
    <model name="cloud_1">
      <static>true</static>
      <pose>40 20 80 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>8</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 1 0.45</ambient>
            <diffuse>1 1 1 0.45</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cloud_2">
      <static>true</static>
      <pose>55 25 80 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>6</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 1 0.45</ambient>
            <diffuse>1 1 1 0.45</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cloud_3">
      <static>true</static>
      <pose>-70 60 90 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>10</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 1 0.35</ambient>
            <diffuse>1 1 1 0.35</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
